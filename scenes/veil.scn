# Twenty translucent layers over a ramp. Almost every pixel is a blend, so the
# frame holds hundreds of distinct near-neighbour values -- the case where a
# coarse quantizer shows as banding rather than as blocking, and where chroma
# and luma disagree about where the edges are.
name veil
size 1280 720
frames 60
fps 30
qp 20

bg luma=128 cb=128 cr=128
grad dir=h from=40 to=210 cb_from=90 cb_to=170 cr_from=170 cr_to=90
rect x=-75 y=400 w=277 h=375 luma=120 cb=113 cr=100 alpha=36 vx=1.44 vy=0.08 bounce=1
