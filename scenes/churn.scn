# Everything difficult at once: dense grain, rotation, translucency, colour
# drift and a cut. Nothing here should compress well -- it exists to show what
# the codec does when no assumption it makes holds.
name churn
size 1280 720
frames 72
fps 30
qp 24

bg luma=90 cb=128 cr=128
grad dir=r from=40 to=200 cb_from=70 cb_to=180 cr_from=185 cr_to=75
noise sigma=9
cut frame=36
rect x=78 y=292 w=149 h=157 luma=96 cb=173 cr=149 spin=4.12 tex=18 alpha=144 vx=-0.47 vy=-0.01 bounce=1 dcb=-2.40 dcr=-0.34
