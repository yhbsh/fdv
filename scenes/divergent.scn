# Opposed motion inside single macroblocks — forces the 8x8 split.
# Each pair is two 8x8 blocks stacked inside one 16x16 macroblock moving in
# opposite directions, so a single 16x16 motion vector cannot describe the block
# and the encoder has to take the split.
#
# Block size, the 8-pixel offset and the velocities are deliberately NOT scaled
# with the frame. A macroblock is 16x16 at every resolution, so the pair has to
# stay inside one: at four times the speed the two halves separate in a single
# frame and the scene quietly stops testing anything.
name divergent
size 1280 720
frames 24
fps 30
qp 20

bg luma=48
grad dir=v from=30 to=70

rect x=32 y=32   w=8 h=8 luma=225 cb=100 cr=150 vx=1.5  vy=0.5  bounce=1
rect x=32 y=40 w=8 h=8 luma=60  cb=165 cr=105 vx=-1.5 vy=-0.5 bounce=1
rect x=128 y=32   w=8 h=8 luma=225 cb=100 cr=150 vx=1.5  vy=0.5  bounce=1
rect x=128 y=40 w=8 h=8 luma=60  cb=165 cr=105 vx=-1.5 vy=-0.5 bounce=1
rect x=224 y=32   w=8 h=8 luma=225 cb=100 cr=150 vx=1.5  vy=0.5  bounce=1
rect x=224 y=40 w=8 h=8 luma=60  cb=165 cr=105 vx=-1.5 vy=-0.5 bounce=1
rect x=320 y=32   w=8 h=8 luma=225 cb=100 cr=150 vx=1.5  vy=0.5  bounce=1
rect x=320 y=40 w=8 h=8 luma=60  cb=165 cr=105 vx=-1.5 vy=-0.5 bounce=1
