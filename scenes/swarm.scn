# A swarm on a spiral — forty circles, each tangent to its own orbit.
# Curved edges at every angle, so the directional intra modes all get used and
# no two neighbouring blocks share a motion vector. Circles are also the shape
# blocking artifacts show on first.
name swarm
size 1280 720
frames 48
fps 30
qp 22

bg luma=30
grad dir=v from=16 to=64

circle x=720 y=360 r=15.5 luma=200 cb=90 cr=90 vx=-0 vy=6.38 bounce=1
