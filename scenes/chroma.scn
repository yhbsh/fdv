# Colour, not brightness. A radial chroma ramp under patches that drift in hue
# and overlap semi-transparently, so most pixels hold a colour no object
# contains. Luma stays gentle on purpose: everything hard here is in Cb/Cr,
# which flat-filled scenes never exercise.
name chroma
size 1280 720
frames 60
fps 30
qp 22

bg luma=110 cb=128 cr=128
grad dir=r from=90 to=150 cb_from=54 cb_to=206 cr_from=200 cr_to=58
rect x=663 y=154 w=221 h=112 luma=99 cb=187 cr=74 alpha=116 vx=0.50 vy=2.46 bounce=1 dcb=-1.14 dcr=-1.66
rect x=856 y=71 w=181 h=123 luma=160 cb=158 cr=65 alpha=142 vx=-2.26 vy=-1.66 bounce=1 dcb=0.51 dcr=1.79
rect x=812 y=50 w=176 h=111 luma=161 cb=84 cr=124 alpha=123 vx=-2.13 vy=-2.29 bounce=1 dcb=-0.77 dcr=1.26
rect x=370 y=105 w=268 h=148 luma=137 cb=74 cr=190 alpha=78 vx=0.39 vy=0.71 bounce=1 dcb=-0.01 dcr=0.13
rect x=643 y=476 w=269 h=216 luma=136 cb=126 cr=113 alpha=93 vx=1.19 vy=-1.54 bounce=1 dcb=0.30 dcr=0.10
