rect x=158 y=321 w=207 h=189 luma=166 cb=177 cr=198 alpha=128 vx=-2.59 vy=-2.44 bounce=1 dcb=-0.92 dcr=0.79
rect x=133 y=62 w=299 h=179 luma=163 cb=164 cr=122 alpha=119 vx=2.32 vy=-0.92 bounce=1 dcb=1.76 dcr=-0.58
