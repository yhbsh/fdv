# A city skyline scrolling past at dusk — a horizontal pan with real occlusion.
# Buildings share one velocity, so the predictor should handle the bulk of it,
# while the lit windows put small high-contrast detail on top of moving blocks.
# The sun is static: one object that must not move while everything else does.
name skyline
size 1280 720
frames 300
fps 30
qp 12

bg luma=30
#grad dir=v from=96 to=22

circle x=928 y=97.5 r=65.88 luma=252 cb=112 cr=150
