# Falling rain — many small objects sharing one dominant direction.
# Tests the motion predictor when almost every block moves the same way but the
# content between them is static: the neighbour predictor should carry it, and
# most of the frame should still be SKIP.
name rain
size 1280 720
frames 40
fps 30
qp 22

bg luma=28
grad dir=v from=18 to=52

rect x=0 y=0 w=8 h=30 luma=150 cb=140 cr=120 vx=-1.6 vy=15 bounce=1
